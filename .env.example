# Copy to .env and adjust. .env is ignored by Git.
POSTGRES_USER=readiness
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=readiness
DATABASE_URL=postgresql+psycopg://readiness:change-me-local-only@127.0.0.1:5433/readiness

# Hellō OpenID Connect application settings.
# Public Client ID from the Hellō Developer Console. No client secret for PKCE.
HELLO_CLIENT_ID=
HELLO_REDIRECT_URI=http://localhost:8000/auth/callback
HELLO_FRONTEND_URL=http://localhost:5173/
SESSION_SECRET=replace-with-a-random-secret
APP_ENV=development
